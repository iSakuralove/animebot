# 复制成 .env 再填。.env 永远不要提交，也不要贴进聊天。
# 旧 token 如果在任何地方泄露过，先去 BotFather /revoke 换新的。

# bot token（裸名，不带 ANIMEBOT_ 前缀）
AnimeCoffeebot=

# 频道 id 用导出 JSON 里的形式（不带 -100 前缀）；填成 -100... 也会被自动纠正
ANIMEBOT_CHANNEL_ID=1702674582
ANIMEBOT_CHANNEL_USERNAME=YXHMd

# 深链总开关
#   public   -> https://t.me/YXHMd/<message_id>        任何人可点
#   internal -> https://t.me/c/1702674582/<message_id> 仅频道成员可见
ANIMEBOT_LINK_MODE=public

# 启用的功能模块。加新模块就往这里加名字，逗号分隔。
ANIMEBOT_FEATURES=system,search

# 管理员 user_id，逗号分隔。/health、/metrics 等 admin_only 指令只对他们开放。
ANIMEBOT_ADMIN_IDS=

ANIMEBOT_DB_PATH=data/animebot.db

# 检索
ANIMEBOT_SEARCH_PAGE_SIZE=8
ANIMEBOT_FUZZY_MIN_SCORE=55

# 外部 API（/bgm、/agent 之类共用）
ANIMEBOT_HTTP_TIMEOUT=10
ANIMEBOT_HTTP_RETRIES=2
ANIMEBOT_HTTP_CACHE_TTL=900

# 可观测性
ANIMEBOT_LOG_LEVEL=INFO
ANIMEBOT_LOG_JSON=false
ANIMEBOT_SLOW_COMMAND_MS=1500
