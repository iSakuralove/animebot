# 复制成 .env 再填。.env 永远不要提交，也不要贴进聊天。
# 旧 token 如果在任何地方泄露过，先去 BotFather /revoke 换新的。

# bot token（裸名，不带 ANIMEBOT_ 前缀）
AnimeCoffeebot=

# 频道 id 用导出 JSON 里的形式（不带 -100 前缀）；填成 -100... 也会被自动纠正
ANIMEBOT_CHANNEL_ID=1702674582
ANIMEBOT_CHANNEL_USERNAME=YXHMd

# 漫画频道（/c 搜它）。导出里没有 username：启动日志 preflight.channel_ok 会打出
# 频道真实的 username，link_mode=public 时抄到这里；留空则漫画链接走 /c/ 内部链接。
ANIMEBOT_MANGA_CHANNEL_ID=1659887654
ANIMEBOT_MANGA_CHANNEL_USERNAME=

# 深链总开关
#   public   -> https://t.me/xxxx/<message_id>        任何人可点
#   internal -> https://t.me/c/xxxxx/<message_id> 仅频道成员可见
ANIMEBOT_LINK_MODE=public

# 启用的功能模块。加新模块就往这里加名字，逗号分隔。manga = /c 漫画检索
ANIMEBOT_FEATURES=system,search,manga,ai

# 管理员 user_id，逗号分隔。/health、/metrics 等 admin_only 指令只对他们开放。
ANIMEBOT_ADMIN_IDS=

ANIMEBOT_DB_PATH=data/animebot.db

# 检索
ANIMEBOT_SEARCH_PAGE_SIZE=8
ANIMEBOT_FUZZY_MIN_SCORE=55

# 外部 API（/bgm、/agent 之类共用）
ANIMEBOT_HTTP_TIMEOUT=10
ANIMEBOT_HTTP_RETRIES=2
ANIMEBOT_HTTP_CACHE_TTL=900

# 可观测性
ANIMEBOT_LOG_LEVEL=INFO
ANIMEBOT_LOG_JSON=false
ANIMEBOT_SLOW_COMMAND_MS=1500

# ---- AI 对话 /q ----
# 走 Anthropic Messages 协议（/v1/messages + SSE）的网关
ANIMEBOT_AI_BASE_URL=https://happycoding.xyz
ANIMEBOT_AI_API_KEY=
# 主模型 + 兜底（主模型 5xx/超时时自动换一个）
# Bangumi Access Token（https://next.bgm.tv/demo/access-token）。
# 不带也能用，只是限流更紧；带上还多了 NSFW 标记可以做过滤。
ANIMEBOT_BGM_TOKEN=

ANIMEBOT_AI_MODEL=deepseek-v4.1-flash
ANIMEBOT_AI_FALLBACK_MODEL=glm-5.3-flash
ANIMEBOT_AI_MAX_TOKENS=2000
# 流式落地方式：draft=草稿流（客户端做动画，私聊最顺滑，结束会补一条正式消息）
#               edit =占位消息+原地编辑（没有动画，但只有一条消息）
# 群聊永远走 edit（草稿不支持群）
ANIMEBOT_AI_STREAM_MODE=draft
# 工具循环上限；到上限会逼模型用已有信息收尾
ANIMEBOT_AI_MAX_TOOL_ROUNDS=4
# 单次 /q 的总超时（含所有工具轮次）
ANIMEBOT_AI_TIMEOUT=120
# 多轮上下文：闲置多久清空 / 保留多少条消息
ANIMEBOT_AI_SESSION_TTL=1800
ANIMEBOT_AI_SESSION_MESSAGES=16
